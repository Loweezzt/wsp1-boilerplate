{% extends "layout.njk" %}

{% block content %}
<h1>{{ title }}</h1>

<main class="movies">
    {% if movies and movies | length %}
        {% for movie in movies %}
            {% set img = movie.image or movie.img or movie.poster or movie.picture or movie.filename or movie.file %}
            <article class="movie">
                {% if img %}
                    <img src="/css/{{ img }}" alt="{{ movie.title or movie.name or 'movie poster' }}" />
                {% endif %}
                {% if movie.title or movie.name %}
                    <h1>{{ movie.title or movie.name }}</h1>
                {% endif %}
                {% if movie.description %}
                    <h3>{{ movie.description }}</h3>
                {% endif %}
            </article>
        {% endfor %}
    {% else %}
        <h2>Inga filmer att visa.</h2>
    {% endif %}

</main>
{% endblock %}