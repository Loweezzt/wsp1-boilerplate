{% extends "layout.njk" %}

{% block content %}
<main>
    <h1>{{ title }}</h1>
    {% for movie in movies %}
    <article>
        <main class="movies"> {%
            for movie in movies %} {% set img = movie.image or movie.img or movie.poster or movie.picture or movie.filename or movie.file %}
                                    <article class="movie"> {% if img %}
                                                <img src="/css/{{ img }}" alt="{{ movie.title or movie.name or 'movie poster' }}" />
                                                {% endif %}
                                    </article> {% endfor %}
        </main>
                <section>
                        {% if movie.description %}
                            <p>{{ movie.description }}</p>
                    {% endif %}
                </section>
        <footer>
        </footer>
    </article>
    {% else %}
        <h2>Inga filmer att visa.</h2>
    {% endfor %}

</main>
{% endblock %}